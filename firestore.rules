rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Get user's profile document from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper check: Does the user document exist?
    function hasProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Helper check: Is the authenticated user a Super Admin?
    function isSuperAdmin() {
      return hasProfile() && getUserData().role == 'Super Admin';
    }
    
    // Helper check: Is the authenticated user any Admin type?
    function isAdmin() {
      return hasProfile() && (
        getUserData().role == 'Admin' || 
        getUserData().role == 'Super Admin'
      );
    }
    
    // Helper check: Does the Admin user have a specific granular feature permission enabled?
    function hasPermission(permission) {
      return hasProfile() && (
        getUserData().role == 'Super Admin' || 
        (getUserData().role == 'Admin' && 
         getUserData().permissions != null && 
         getUserData().permissions[permission] == true)
      );
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if isAuthenticated();
      
      // Allow users to create their own profile during sign-up, or allow Admin / Super Admin
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isSuperAdmin()
      );
      
      // Update rules: Admins and Super Admins can update all accounts. Users can update their own account.
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        isAdmin() || 
        request.auth.uid == userId
      );
      
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        isAdmin()
      );
    }
    
    // 2. Regional Areas Collection
    match /areas/{areaId} {
      allow read: if true; // Public read so unauthenticated users can select an area during sign-up
      allow write: if isSuperAdmin();
    }
    
    // 3. Meetings Collection
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('manageMeetings');
    }
    
    // 4. Events Collection
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('manageEvents');
    }
    
    // 5. Announcements Collection
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // 6. Activities Collection
    match /activities/{actId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.postedBy == request.auth.uid);
    }
    
    // 7. Attendance Collection (Meetings)
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid || 
        hasPermission('viewAttendance')
      );
      allow write: if isSuperAdmin() || isAdmin() || hasPermission('takeAttendance');
    }
    
    // 8. Event Attendance Collection
    match /event_attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid || 
        hasPermission('viewAttendance')
      );
      allow write: if isSuperAdmin() || isAdmin() || hasPermission('takeAttendance');
    }
    
    // 9. Fees Collection
    match /fees/{feeId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid || 
        hasPermission('viewDues') || 
        hasPermission('generateDues')
      );
      allow create, delete: if isSuperAdmin() || isAdmin() || hasPermission('generateDues');
      allow update: if isSuperAdmin() || isAdmin() || hasPermission('viewDues') || hasPermission('generateDues');
    }

    // 10. Centralized Settings Collection
    match /settings/{settingId} {
      allow read: if settingId == 'homepage' || isAuthenticated();
      allow write: if isSuperAdmin() || isAdmin() || (settingId == 'fees' && hasPermission('generateDues'));
    }

    // 11. Member Attendance Collection (Date-based Calendar)
    match /member_attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        hasPermission('viewAttendance')
      );
      allow write: if isSuperAdmin() || isAdmin() || hasPermission('takeAttendance');
    }
    
    // 12. Payments Collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        hasPermission('viewPayment') ||
        hasPermission('viewDues')
      );
      allow write: if isSuperAdmin() || isAdmin() || hasPermission('logPayment') || hasPermission('generateDues');
    }

    // 13. Other Income Collection
    match /other_income/{incomeId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        hasPermission('viewDues') || 
        hasPermission('generateDues')
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        hasPermission('generateDues') || 
        hasPermission('logPayment')
      );
    }

    // 14. Expenses Collection
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        hasPermission('viewDues') || 
        hasPermission('generateDues')
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        hasPermission('generateDues') || 
        hasPermission('logPayment')
      );
    }

    // 15. Phone to Email Mappings for login lookup
    match /phone_mappings/{phoneId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAuthenticated();
    }

    // 16. OTP Verification Codes
    match /otps/{phoneId} {
      allow get, create, update, delete: if true;
      allow list: if false;
    }
  }
}

